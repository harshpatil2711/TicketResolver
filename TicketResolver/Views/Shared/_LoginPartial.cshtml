@using System.Security.Claims
@if (User.Identity.IsAuthenticated)
{
    var identity = (ClaimsPrincipal)User;
    var firstName = identity.FindFirst(ClaimTypes.Email)?.Value?.Split('@')[0] ?? "User";
    <text>
        <span>Hello, @firstName <i class="fa-solid fa-angle-down"></i></span>
        @using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { id = "logoutForm" }))
        {
            @Html.AntiForgeryToken()
        }
    </text>
}
else
{
    <text>
        <a href="@Url.Action("Login", "Auth")" style="color:#555;text-decoration:none;font-weight:600;">Sign In</a>
        <a href="@Url.Action("Register", "Auth")" style="color:#555;text-decoration:none;font-weight:600;">Register</a>
    </text>
}
