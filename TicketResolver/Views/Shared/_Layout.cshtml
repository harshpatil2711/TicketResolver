@using System.Security.Claims
@{
    var isAuthenticated = User.Identity.IsAuthenticated;
    var role = "";
    var fullName = "";
    if (isAuthenticated)
    {
        var identity = (ClaimsPrincipal)User;
        role = identity.FindFirst(ClaimTypes.Role)?.Value ?? "";
        var email = identity.FindFirst(ClaimTypes.Email)?.Value ?? "";
        fullName = email.Split('@')[0];
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - TicketResolver</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="@Url.Content("~/Content/custom.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    @if (isAuthenticated)
    {
        <aside class="sidebar">
            <div class="sidebar-brand">Helpdesk System</div>
            <ul class="sidebar-menu">
                <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <a href="@Url.Action("Index", "Home")"><i class="fa-solid fa-gauge"></i> Dashboard</a>
                </li>
                @if (role == "Administrator" || role == "Support Executive")
                {
                    <li><a href="@Url.Action("Index", "Ticket")"><i class="fa-solid fa-ticket"></i> Tickets</a></li>
                    <li><a href="@Url.Action("Index", "User")"><i class="fa-solid fa-user-group"></i> Users</a></li>
                    if (role == "Administrator")
                    {
                        <li><a href="@Url.Action("Index", "MasterData")"><i class="fa-solid fa-gear"></i> Master Data</a></li>
                    }
                }
                else
                {
                    <li><a href="@Url.Action("Create", "Ticket")"><i class="fa-solid fa-circle-plus"></i> Create Ticket</a></li>
                    <li><a href="@Url.Action("Index", "Ticket")"><i class="fa-solid fa-ticket"></i> My Tickets</a></li>
                }
                <li><a href="@Url.Action("Index", "Profile")"><i class="fa-solid fa-user"></i> My Profile</a></li>
            </ul>
        </aside>
    }

    <div class="@(isAuthenticated ? "main-wrapper" : "full-page")">
        @if (isAuthenticated)
        {
            <header class="navbar">
                <div></div>
                <div class="user-menu">
                    <i class="fa-regular fa-bell"></i>
                    <i class="fa-solid fa-gear"></i>
                    @Html.Partial("_LoginPartial")
                    <a href="javascript:document.getElementById('logoutForm').submit()" style="color:#555;text-decoration:none;margin-left:10px;">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>
            </header>
        }

        <main class="content-container">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="@Url.Content("~/Scripts/auth.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
