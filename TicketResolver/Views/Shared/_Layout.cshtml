@using System.Security.Claims
@{
    var isAuthenticated = User.Identity.IsAuthenticated;
    var role = "";
    var fullName = "";
    if (isAuthenticated)
    {
        var identity = (ClaimsPrincipal)User;
        role = identity.FindFirst(ClaimTypes.Role)?.Value ?? "";
        fullName = identity.FindFirst(ClaimTypes.Name)?.Value ?? identity.FindFirst(ClaimTypes.Email)?.Value?.Split('@')[0] ?? "User";
    }
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    Func<string, bool> IsActive = c => controller == c;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Ticket Resolver</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="@Url.Content("~/Content/custom.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>

    @if (isAuthenticated)
    {
        <aside class="sidebar">
            <div class="sidebar-brand">Ticket Resolver</div>
            <ul class="sidebar-menu">
                <li class="@(IsActive("Home") ? "active" : "")">
                    <a href="@Url.Action("Index", "Home")"><i class="fa-solid fa-gauge"></i> Dashboard</a>
                </li>
                @if (role == "Administrator" || role == "Support Executive")
                {
                    <li class="@(IsActive("Ticket") && action == "Index" ? "active" : "")">
                        <a href="@Url.Action("Index", "Ticket")"><i class="fa-solid fa-ticket"></i> Tickets</a>
                    </li>
                    if (role == "Administrator")
                    {
                        <li class="@(IsActive("User") ? "active" : "")">
                            <a href="@Url.Action("Index", "User")"><i class="fa-solid fa-user-group"></i> Agents</a>
                        </li>
                        <li class="@(IsActive("MasterData") ? "active" : "")">
                            <a href="@Url.Action("Index", "MasterData")"><i class="fa-solid fa-gear"></i> Settings</a>
                        </li>
                    }
                }
                else
                {
                    <li class="@(IsActive("Ticket") && action == "Create" ? "active" : "")">
                        <a href="@Url.Action("Create", "Ticket")"><i class="fa-solid fa-circle-plus"></i> Create Ticket</a>
                    </li>
                    <li class="@(IsActive("Ticket") && action == "Index" ? "active" : "")">
                        <a href="@Url.Action("Index", "Ticket")"><i class="fa-solid fa-ticket"></i> My Tickets</a>
                    </li>
                }
                <li class="@(IsActive("Profile") ? "active" : "")">
                    <a href="@Url.Action("Index", "Profile")"><i class="fa-solid fa-user"></i> My Profile</a>
                </li>
            </ul>
        </aside>
    }

    <div class="main-wrapper">
        @if (isAuthenticated)
        {
            <header class="navbar-top">
                <div></div>
                <div class="user-menu">
                    <i class="fa-regular fa-bell"></i>
                    <i class="fa-solid fa-gear"></i>
                    <span>Hello, @fullName <i class="fa-solid fa-angle-down"></i></span>
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="text-decoration-none text-secondary">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </a>
                </div>
            </header>
            using (Html.BeginForm("Logout", "Auth", FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
            {
                @Html.AntiForgeryToken()
            }
        }

        <main class="content-container">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
