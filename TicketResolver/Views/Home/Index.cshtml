@model TicketResolver.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h5 class="page-title">Dashboard</h5>
    <span class="alert-banner"><i class="fa-regular fa-bell me-1"></i> Welcome back!</span>
</div>

<div class="stats-grid">
    <div class="stat-card border-green">
        <div class="stat-title">Total Tickets</div>
        <div class="stat-value">@Model.TotalTickets</div>
    </div>
    <div class="stat-card border-red">
        <div class="stat-title">New Tickets</div>
        <div class="stat-value">@Model.NewTickets</div>
    </div>
    <div class="stat-card border-yellow">
        <div class="stat-title">Open Tickets</div>
        <div class="stat-value">@Model.AssignedTickets</div>
    </div>
    <div class="stat-card border-blue">
        <div class="stat-title">In Progress</div>
        <div class="stat-value">@Model.InProgressTickets</div>
    </div>
    <div class="stat-card border-blue">
        <div class="stat-title">Resolved</div>
        <div class="stat-value">@Model.ResolvedTickets</div>
    </div>
    <div class="stat-card border-orange">
        <div class="stat-title">Closed</div>
        <div class="stat-value">@Model.ClosedTickets</div>
    </div>
    <div class="stat-card border-yellow">
        <div class="stat-title">Reopened</div>
        <div class="stat-value">@Model.ReopenedTickets</div>
    </div>
</div>

<div class="dashboard-layout">
    <div class="card-custom">
        <div class="card-header-custom">Recent Tickets</div>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ticket #</th>
                    <th>Name</th>
                    <th>Subject</th>
                    <th>Assigned To</th>
                    <th>Updated</th>
                    <th>Action</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentTickets.Count == 0)
                {
                    <tr><td colspan="8"><div class="empty-msg">No recent tickets found.</div></td></tr>
                }
                @foreach (var ticket in Model.RecentTickets)
                {
                    <tr>
                        <td>@ticket.TicketId</td>
                        <td><a href="@Url.Action("Details", "Ticket", new { id = ticket.TicketId })" style="color:#2b3e50;font-weight:600;text-decoration:none;">@ticket.TicketNumber</a></td>
                        <td>@ticket.CreatedByName</td>
                        <td>@ticket.Subject</td>
                        <td>@(ticket.AssignedToName ?? "-")</td>
                        <td class="small" style="color:#888;">@ticket.CreatedDate.ToString("dd-MMM-yyyy")</td>
                        <td><a href="@Url.Action("Details", "Ticket", new { id = ticket.TicketId })" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-eye"></i></a></td>
                        <td><span class="badge bg-secondary">@ticket.StatusName</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <span>Ticket Analysis</span>
            <div class="d-flex gap-2">
                <button type="button" id="btnChartStatus" class="btn btn-sm btn-dark">Status wise</button>
                <button type="button" id="btnChartPriority" class="btn btn-sm btn-outline-secondary">Priority wise</button>
            </div>
        </div>
        <div style="min-height:240px;text-align:center;">
            <canvas id="ticketPieChart" height="180"></canvas>
        </div>
        <div class="chart-legend" id="chartLegend"></div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="@Url.Content("~/Scripts/dashboard.js")"></script>
}
