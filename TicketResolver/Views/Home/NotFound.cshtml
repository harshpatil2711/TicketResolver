@{
    ViewBag.Title = "Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header">
    <h5 class="page-title">404 - Page Not Found</h5>
</div>
<div class="card-custom">
    <div style="padding:20px;">
        <div class="alert alert-warning mb-0">
            <h6 class="alert-heading">Page not found</h6>
            <p class="mb-0">The page you are looking for does not exist or has been removed.</p>
        </div>
        <div class="mt-3">
            <a href="@Url.Action("Index", "Home")" class="btn btn-green">Go to Dashboard</a>
        </div>
    </div>
</div>
