@model TicketResolver.ViewModels.TicketAssignViewModel
@{
    ViewBag.Title = "Assign Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h5 class="page-title">Assign Ticket - @Model.TicketNumber</h5>
    <a href="@Url.Action("Details", new { id = Model.TicketId })" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="card-custom">
    <div style="padding:20px;">
        <p class="mb-3"><strong>Subject:</strong> @Model.Subject</p>

        @using (Html.BeginForm("Assign", "Ticket", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.TicketId)
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                @Html.LabelFor(m => m.AssignedTo, "Assign To", new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(m => m.AssignedTo, new SelectList(Model.SupportExecutives, "UserId", "FullName"), "Select Support Executive", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.AssignedTo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ChangeReason, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(m => m.ChangeReason, new { @class = "form-control", rows = 3, placeholder = "Optional note" })
            </div>

            <button type="submit" class="btn btn-green px-4">Assign</button>
        }
    </div>
</div>

