@model TicketResolver.ViewModels.UserSearchViewModel
@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h5 class="page-title">Users</h5>
    <a href="@Url.Action("Create")" class="btn btn-green btn-sm"><i class="fa-solid fa-plus"></i> Create User</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card-custom" style="margin-bottom:15px;">
    <div class="card-header-custom">Search</div>
    <form id="searchForm" style="padding:20px;">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" id="searchTerm" name="searchTerm" class="form-control" placeholder="Search name or email" value="@Model.SearchTerm" />
            </div>
            <div class="col-md-2">
                @Html.DropDownList("roleId", new SelectList(Model.Roles, "RoleId", "RoleName", Model.RoleId), "All Roles", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                <select id="isActive" name="isActive" class="form-select">
                    <option value="">All</option>
                    <option value="true" @(Model.IsActive == true ? "selected" : "")>Active</option>
                    <option value="false" @(Model.IsActive == false ? "selected" : "")>Inactive</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-green w-100"><i class="fa-solid fa-search"></i></button>
            </div>
            <div class="col-md-3">
                <a href="#" id="clearBtn" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </div>
    </form>
</div>

<div id="userTableContainer" data-url="@Url.Action("Index", "User")">
    @Html.Partial("_UserTable", Model)
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/user-index.js")"></script>
}
